{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hometaskapp",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {"crons": []},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hometaskapp-db",
      "database_id": "d041fcc3-9377-40fc-ac25-31fbe7d6e70b",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "compras": {
      "name": "hometaskapp-compras",
      "triggers": {"crons": []},
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hometaskapp-db",
          "database_id": "d041fcc3-9377-40fc-ac25-31fbe7d6e70b",
          "migrations_dir": "migrations"
        }
      ]
    },
    "preview": {
      "name": "hometaskapp-preview",
      "triggers": {"crons": []},
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hometaskapp-preview-db",
          "database_id": "c25b1c8b-8700-4f09-b822-983efdd6a7a9",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
