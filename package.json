{
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0",
    "miniflare": "5.20260903.0-alpha"
  },
  "name": "home-task-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "preview": "node scripts/preview.mjs",
    "verify": "npm run build && npm run typecheck && npm test"
  }
}
